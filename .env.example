# Porta externa da API FastAPI
SMART15_BACKEND_PORT=8000

# Porta externa da aplicação GeoLibre
SMART15_WEB_PORT=8080

# Serviço de busca manual de endereços (Nominatim/OpenStreetMap)
SMART15_NOMINATIM_URL=https://nominatim.openstreetmap.org/search

# Limite para evitar que polígonos excessivos sobrecarreguem o processamento local
SMART15_MAX_STUDY_AREA_KM2=100

# Extensão máxima de longitude/latitude do limite (aproximação segura para áreas locais)
SMART15_MAX_STUDY_BBOX_SPAN_DEGREES=1.0

# Limite total dos arquivos enviados por simulação (4 GiB; proxy Nginx aceita até 5 GiB)
SMART15_MAX_UPLOAD_SIZE_BYTES=4294967296
